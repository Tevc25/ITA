{
  "name": "faas-events",
  "version": "1.0.0",
  "private": true,
  "description": "Serverless FaaS backend for Smart Parking events",
  "scripts": {
    "offline": "serverless offline --stage local",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:prod": "serverless deploy --stage prod",
    "remove:dev": "serverless remove --stage dev",
    "logs:processNotifications": "serverless logs -f processNotificationQueue --stage dev",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.911.0",
    "@aws-sdk/client-s3": "^3.911.0",
    "@aws-sdk/client-sqs": "^3.911.0",
    "@aws-sdk/lib-dynamodb": "^3.911.0",
    "@aws-sdk/s3-request-presigner": "^3.911.0",
    "@aws-sdk/util-dynamodb": "^3.911.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "serverless": "^3.40.0",
    "serverless-offline": "^13.8.1"
  },
  "engines": {
    "node": ">=20"
  }
}
